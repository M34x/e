# Copy to .env; never commit .env or expose these values in browser code.
OPENLLM_API_KEY=
# Full OpenAI-compatible chat completions URL from your gateway configuration.
OPENLLM_ENDPOINT=
# Optional model ID; defaults to gpt-4o if not set. Image questions need a vision-capable model.
OPENLLM_MODEL=
# Set true only when your configured OpenAI-compatible endpoint/model accepts image_url content parts.
OPENLLM_VISION_ENABLED=false
PORT=3000
